{
  "name": "tank-realms",
  "version": "0.1.0",
  "private": true,
  "description": "Tank Realms mobile game",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:web": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "npm run build:web && cap add android",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug && cd .. && node scripts/copy-apk.mjs",
    "test": "npm run build:web && node --test",
    "check:js": "eslint assets/js src tests scripts *.mjs",
    "check:html": "html-validate index.html tank_realms_debugged_hud.html",
    "check": "npm run check:js && npm run check:html && npm test"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "html-validate": "^9.7.1",
    "jsdom": "^26.1.0",
    "vite": "8.2.1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "three": "0.128.0"
  }
}
